subdir = Src
dir_top = ..
SUBDIRS =

@VERSION_MK@

# source/build directories
VPATH           = @srcdir@
sdir            = @srcdir@
sdir_top        = @top_srcdir@
INSTALL         = @INSTALL@
LN		= @LN@

@DEFS_MK@

BRIGHTDATE_WORKSPACE = $(sdir_top)/brightdate-rust
BRIGHTDATE_FFI_LIB   = $(BRIGHTDATE_WORKSPACE)/target/release/libbrightdate_ffi.a
# -framework CoreFoundation is required on macOS (iana-time-zone) but
# is not a valid GCC option on Linux.
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
    BRIGHTDATE_EXTRA_LDFLAGS := -framework CoreFoundation
else
    BRIGHTDATE_EXTRA_LDFLAGS :=
endif

.PHONY: brightdate-ffi-build
brightdate-ffi-build:
	cd $(BRIGHTDATE_WORKSPACE) && $(CARGO) build --release -p brightdate-ffi

$(BRIGHTDATE_FFI_LIB): brightdate-ffi-build

sdir_src      = $(sdir)
dir_src       = .

# ========= DEPENDENCIES FOR BUILDING ==========

LINK        = $(CC) $(LDFLAGS) $(EXELDFLAGS) $(EXTRA_LDFLAGS) -o $@
DLLINK      = $(DLLD) $(LDFLAGS) $(LIBLDFLAGS) $(DLLDFLAGS) -o $@

all: bin modules
.PHONY: all

bin: bsh$(EXEEXT)
.PHONY: bin

modules: headers
.PHONY: modules

MAIN_OBJS = main.o

L = @L@

LSTMP =
LLIST =
NSTMP = stamp-modobjs
NLIST = `cat stamp-modobjs`

LIBBSH = libbsh-$(VERSION).$(DL_EXT)
NIBBSH =
INSTLIB = @INSTLIB@
UNINSTLIB = @UNINSTLIB@

BSH_EXPORT = $(EXPOPT)bsh.export
BSH_NXPORT =
ENTRYOBJ   = modentry..o
NNTRYOBJ   =

LDRUNPATH = LD_RUN_PATH=$(libdir)/$(tbsh)
NDRUNPATH =

EXTRABSHOBJS = @EXTRABSHOBJS@

bsh$(EXEEXT): $(@L@IBBSH) $(@L@STMP) $(MAIN_OBJS) bsh.export $(EXTRABSHOBJS) $(BRIGHTDATE_FFI_LIB)
	rm -f $@
	$(@L@DRUNPATH) $(LINK) $(MAIN_OBJS) $(EXTRABSHOBJS) $(@L@LIST) $(BSH_@E@XPORT) $(@L@IBBSH) $(LIBS) $(BRIGHTDATE_FFI_LIB) $(BRIGHTDATE_EXTRA_LDFLAGS)

$(LIBBSH): $(LIBOBJS) $(NSTMP)
	rm -f $@
	$(DLLINK) $(LIBOBJS) $(NLIST) $(LIBS)

bsh.res.o: $(sdir)/bsh.rc $(sdir)/bsh.ico
	windres -O coff --include-dir $(sdir) -i $(sdir)/bsh.rc -o bsh.res.o

stamp-modobjs: modobjs
	@if cmp -s stamp-modobjs.tmp stamp-modobjs; then \
	    rm -f stamp-modobjs.tmp; \
	else \
	    mv -f stamp-modobjs.tmp stamp-modobjs; \
	    echo "Updated \`stamp-modobjs'."; \
	fi

modobjs: headers rm-modobjs-tmp
.PHONY: modobjs

rm-modobjs-tmp:
	rm -f stamp-modobjs.tmp
.PHONY: rm-modobjs-tmp

@CONFIG_MK@

Makemod: $(CONFIG_INCS) $(dir_top)/config.modules
	@case $(sdir_top) in \
	    /*) top_srcdir=$(sdir_top) ;; \
	    *) top_srcdir=$(subdir)/$(sdir_top) ;; \
	esac; \
	export top_srcdir; \
	echo 'cd $(dir_top) && $(SHELL)' \
	    '$$top_srcdir/$(subdir)/mkmakemod.sh $(subdir) Makemod'; \
	cd $(dir_top) && \
	    $(SHELL) $$top_srcdir/$(subdir)/mkmakemod.sh $(subdir) Makemod
prep: Makemod
	@$(MAKE) -f Makemod $(MAKEDEFS) prep || rm -f Makemod
.PHONY: prep

FORCE:
.PHONY: FORCE

# ========== LINKING IN MODULES ==========

mymods.conf:
	@echo Linking with the standard modules.

modules: $(@E@NTRYOBJ)

$(ENTRYOBJ): FORCE
	@$(MAKE) -f Makemod $(MAKEDEFS) $@

# ========== DEPENDENCIES FOR INSTALLING ==========

install: install.bin install.modules
uninstall: uninstall.bin uninstall.modules
.PHONY: install uninstall

install.bin: install.bin-here
uninstall.bin: uninstall.bin-here
.PHONY: install.bin uninstall.bin

# install binary, creating install directory if necessary
install.bin-here: bsh$(EXEEXT) $(INSTLIB)
	${SHELL} $(sdir_top)/mkinstalldirs $(DESTDIR)$(bindir)
	$(INSTALL_PROGRAM) $(STRIPFLAGS) bsh$(EXEEXT) $(DESTDIR)$(bindir)/$(tbsh)-$(VERSION)$(EXEEXT)
	if test -f $(DESTDIR)$(bindir)/$(tbsh)$(EXEEXT); then \
	    rm -f $(DESTDIR)$(bindir)/$(tbsh).old; \
	    $(LN) $(DESTDIR)$(bindir)/$(tbsh)$(EXEEXT) $(DESTDIR)$(bindir)/$(tbsh).old; \
	else :; fi
	rm -f $(DESTDIR)$(bindir)/$(tbsh).new
	$(LN) $(DESTDIR)$(bindir)/$(tbsh)-$(VERSION)$(EXEEXT) $(DESTDIR)$(bindir)/$(tbsh).new
	mv $(DESTDIR)$(bindir)/$(tbsh).new $(DESTDIR)$(bindir)/$(tbsh)$(EXEEXT)
.PHONY: install.bin-here

install.bin-N:
install.bin-L: $(LIBBSH)
	${SHELL} $(sdir_top)/mkinstalldirs $(DESTDIR)$(libdir)/$(tbsh)
	$(INSTALL_PROGRAM) $(LIBBSH) $(DESTDIR)$(libdir)/$(tbsh)/$(LIBBSH)
install.cygwin-lib: $(LIBBSH)
	${SHELL} $(sdir_top)/mkinstalldirs $(DESTDIR)$(bindir)
	$(INSTALL_PROGRAM) $(LIBBSH) $(DESTDIR)$(bindir)/$(LIBBSH)
.PHONY: install.bin-N install.bin-L install.cygwin-lib

# uninstall binary
uninstall.bin-here: $(UNINSTLIB)
	rm -f $(DESTDIR)$(bindir)/$(tbsh)-$(VERSION) $(DESTDIR)$(bindir)/$(tbsh)$(EXEEXT)
.PHONY: uninstall.bin-here uninstall.bin-@L@

uninstall.bin-N:
uninstall.bin-L:
	rm -f $(DESTDIR)$(libdir)/$(tbsh)/$(LIBBSH)
uninstall.cygwin-lib:
	rm -f $(DESTDIR)$(bindir)/$(LIBBSH)
.PHONY: uninstall.bin-N uninstall.bin-L uninstall.cygwin-lib

# ========== DEPENDENCIES FOR CLEANUP ==========

# Since module cleanup rules depend on Makemod, they come first.  This
# forces module stuff to get cleaned before Makemod itself gets
# deleted.

mostlyclean-here:
	rm -f stamp-modobjs stamp-modobjs.tmp
.PHONY: mostlyclean-here

clean-here:
	rm -f modules.stamp bsh$(EXEEXT)
	rm -f libbsh-*.$(DL_EXT)
.PHONY: clean-here

distclean-here:
	rm -f TAGS tags
	rm -f Makefile
.PHONY: distclean-here

mostlyclean: mostlyclean-modules
clean: clean-modules
distclean: distclean-modules
realclean: realclean-modules
.PHONY: mostlyclean clean distclean realclean

# Don't remake Makemod just to delete things, even if it doesn't exist.
mostlyclean-modules clean-modules distclean-modules realclean-modules:
	if test -f Makemod; then \
	  $(MAKE) -f Makemod $(MAKEDEFS) `echo $@ | sed 's/-modules//'`; \
	fi; \
	exit 0
.PHONY: mostlyclean-modules clean-modules distclean-modules \
	realclean-modules

@CLEAN_MK@

# ========== RECURSIVE MAKES ==========

install.modules uninstall.modules \
modobjs modules headers proto $(MAIN_OBJS) bsh.export: Makemod
	@$(MAKE) -f Makemod $(MAKEDEFS) $@
.PHONY: install.modules uninstall.modules headers proto

$(MAIN_OBJS): $(sdir)/bsh.h
