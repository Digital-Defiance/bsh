#!/usr/bin/make -f

# Prevent cargo from trying to reach the network and isolate its home dir
export CARGO_HOME = $(CURDIR)/debian/.cargo-home

%:
	dh $@

override_dh_auto_configure:
	# Launchpad git clones often omit submodule tree contents; ensure the
	# pinned brightdate-rust release is present before configure/build.
	@python3 debian/fetch-brightdate-rust.py
	# dh will auto-run autoreconf; pass bsh-specific configure flags
	dh_auto_configure -- \
		--enable-etcdir=/etc \
		--enable-bshenv=/etc/bsh/bshenv \
		--enable-bshrc=/etc/bsh/bshrc \
		--enable-zprofile=/etc/bsh/zprofile \
		--enable-zlogin=/etc/bsh/zlogin \
		--enable-zlogout=/etc/bsh/zlogout \
		--enable-function-subdirs \
		--enable-multibyte \
		--enable-pcre \
		--enable-cap

override_dh_auto_build:
	# Wire up vendored Rust deps if present (run `make vendor-rust` first).
	# Launchpad builders are network-isolated; vendoring is required.
	@if [ -d brightdate-rust/vendor ]; then \
		mkdir -p brightdate-rust/.cargo; \
		if [ ! -f brightdate-rust/.cargo/config.toml ]; then \
			printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "vendor"\n' \
				> brightdate-rust/.cargo/config.toml; \
		fi; \
	fi
	# dpkg-source 3.0 (quilt) may strip *.orig files even with the
	# diff-ignore override in debian/source/options.  Remove any
	# Cargo.toml.orig entries from .cargo-checksum.json manifests so
	# cargo does not abort when it cannot find the absent files.
	@for f in brightdate-rust/vendor/*/.cargo-checksum.json; do \
		[ -f "$$f" ] || continue; \
		sed -i 's/,"Cargo\.toml\.orig":"[^"]*"//g; s/"Cargo\.toml\.orig":"[^"]*",//g' "$$f"; \
	done
	# Noble / Rust < 1.85 compatibility: clap_lex 1.1.0 and assert_cmd 2.2.1
	# declare edition = "2024" which requires rustc 1.85.  If the system
	# rustc is older, re-stamp both vendored Cargo.toml files to edition 2021,
	# drop the rust-version constraint, and refresh the per-file SHA-256 entry
	# in .cargo-checksum.json so cargo does not reject the modified manifest.
	@RUSTC_VER=$$(rustc --version | awk '{print $$2}'); \
	if dpkg --compare-versions "$$RUSTC_VER" lt "1.85"; then \
		echo "rustc $$RUSTC_VER < 1.85: patching vendored crates to edition 2021"; \
		for crate in brightdate-rust/vendor/clap_lex brightdate-rust/vendor/assert_cmd; do \
			[ -f "$$crate/Cargo.toml" ] || continue; \
			sed -i 's/^edition = "2024"/edition = "2021"/' "$$crate/Cargo.toml"; \
			sed -i '/^rust-version = "1\.85"/d' "$$crate/Cargo.toml"; \
			NEW_HASH=$$(sha256sum "$$crate/Cargo.toml" | awk '{print $$1}'); \
			python3 -c "import json; fn='$$crate/.cargo-checksum.json'; d=json.load(open(fn)); d['files']['Cargo.toml']='$$NEW_HASH'; open(fn,'w').write(json.dumps(d, separators=(',',':')))" ; \
		done; \
	fi
	dh_auto_build
