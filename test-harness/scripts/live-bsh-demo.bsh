#!/usr/bin/env bsh
# Live BrightLink v1 demo of bsh-inject + link-geo against running BrightNexus.app.
#
# Three credentials should appear in the menu bar Credentials submenu and
# the Dashboard view; the geo surface should return real coordinates if
# CoreLocation is authorized for BrightNexus.
#
# Run with:
#   /Volumes/Code/bsh/Src/bsh /Volumes/Code/bsh/test-harness/scripts/live-bsh-demo.bsh

zmodload bsh/brightlink

print -- "===== bsh version ====="
print -- "  $BSH_VERSION"
print

print -- "===== Credential delivery (bsh-inject -> BrightNexus) ====="

printf '%s' '{"label":"GitHub OAuth","value":"ghp_FAKE_x9kP4mQ2RtY8nL3vB7w","ttl":600,"masked":true,"kind":"token"}' \
  | bsh-inject --type plaintext --context "https://api.github.com"

printf '%s' '{"username":"alice","password":"hunter2-link-v1","email":"alice@example.com","ttl":600,"issued_at":1779461600}' \
  | bsh-inject --type ephemeral-auth --context "http://localhost:3005"

printf '%s' '{"engine":"postgres","host":"prod-db.internal","port":5432,"user":"svc","pass":"shhh-link-v1","ttl":600,"issued_at":1779461600}' \
  | bsh-inject --type db-connection --context "postgres://prod-db"

print -- "  three credentials delivered via real bsh-inject (BrightLink v1) — check the BrightNexus menu bar"
print

print -- "===== Geo surface (link-geo -> BrightNexus) ====="

print -- "-- status --"
link-geo status

print
print -- "-- get --format both --"
link-geo get --format both

print
print -- "-- zone --"
link-geo zone

print
print -- "Done."
