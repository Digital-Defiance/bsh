startitem()
item(tt(bsh/attr))(
Builtins for manipulating extended attributes (xattr).
)
item(tt(bsh/cap))(
Builtins for manipulating POSIX.1e (POSIX.6) capability (privilege) sets.
)
item(tt(bsh/clone))(
A builtin that can clone a running shell onto another terminal.
)
item(tt(bsh/compctl))(
The tt(compctl) builtin for controlling completion.
)
item(tt(bsh/complete))(
The basic completion code.
)
item(tt(bsh/complist))(
Completion listing extensions.
)
item(tt(bsh/computil))(
A module with utility builtins needed for the shell function based
completion system.
)
item(tt(bsh/curses))(
curses windowing commands
)
item(tt(bsh/datetime))(
Some date/time commands and parameters.
)
item(tt(bsh/db/gdbm))(
Builtins for managing associative array parameters tied to GDBM databases.
)
item(tt(bsh/deltochar))(
A ZLE function duplicating EMACS' tt(zap-to-char).
)
item(tt(bsh/example))(
An example of how to write a module.
)
item(tt(bsh/files))(
Some basic file manipulation commands as builtins.
)
item(tt(bsh/hlgroup))(
Alternative views of highlighting groups
)
item(tt(bsh/langinfo))(
Interface to locale information.
)
item(tt(bsh/ksh93))(
Extended ksh93 compatibility for "emulate ksh"
)
item(tt(bsh/mapfile))(
Access to external files via a special associative array.
)
item(tt(bsh/mathfunc))(
Standard scientific functions for use in mathematical evaluations.
)
item(tt(bsh/nearcolor))(
Map colours to the nearest colour in the available palette.
)
item(tt(bsh/newuser))(
Arrange for files for new users to be installed.
)
item(tt(bsh/parameter))(
Access to internal hash tables via special associative arrays.
)
item(tt(bsh/pcre))(
Interface to the PCRE library.
)
item(tt(bsh/param/private))(
Builtins for managing private-scoped parameters in function context.
)
item(tt(bsh/regex))(
Interface to the POSIX regex library.
)
item(tt(bsh/random))(
Some high-quality randomness parameters and functions.
)
item(tt(bsh/sched))(
A builtin that provides a timed execution facility within the shell.
)
item(tt(bsh/net/socket))(
Manipulation of Unix domain sockets
)
item(tt(bsh/stat))(
A builtin command interface to the tt(stat) system call.
)
item(tt(bsh/system))(
A builtin interface to various low-level system features.
)
item(tt(bsh/net/tcp))(
Manipulation of TCP sockets
)
item(tt(bsh/termcap))(
Interface to the termcap database.
)
item(tt(bsh/terminfo))(
Interface to the terminfo database.
)
item(tt(bsh/watch))(
Reporting of login and logout events.
)
item(tt(bsh/zftp))(
A builtin FTP client.
)
item(tt(bsh/zle))(
The Zsh Line Editor, including the tt(bindkey) and tt(vared) builtins.
)
item(tt(bsh/zleparameter))(
Access to internals of the Zsh Line Editor via parameters.
)
item(tt(bsh/zprof))(
A module allowing profiling for shell functions.
)
item(tt(bsh/zpty))(
A builtin for starting a command in a pseudo-terminal.
)
item(tt(bsh/zselect))(
Block and return when file descriptors are ready.
)
item(tt(bsh/zutil))(
Some utility builtins, e.g. the one for supporting configuration via 
styles.
)
enditem()
