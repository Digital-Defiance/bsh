sect(Files)
cindex(files used)
startlist()
list(tt($ZDOTDIR/.bshenv))
list(tt($ZDOTDIR/.zprofile))
list(tt($ZDOTDIR/.bshrc))
list(tt($ZDOTDIR/.zlogin))
list(tt($ZDOTDIR/.zlogout))
list(tt(${TMPPREFIX}*)   (default is /tmp/bsh*))
list(tt(bshenv()))
list(tt(zprofile()))
list(tt(bshrc()))
list(tt(zlogin()))
list(tt(zlogout())    (installation-specific - tt(/etc) is the default))
endlist()
